{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unhollowed 2",
  "version": "1.0.0-beta.1",
  "identifier": "dev.arlecchino.unhollowed2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unhollowed 2",
        "width": 1120,
        "height": 760,
        "minWidth": 620,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; font-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": { "version": "0.99.1" }
    },
    "publisher": "Arlecchino",
    "copyright": "Copyright © 2026 Arlecchino",
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A local-first productivity workspace",
    "longDescription": "Projects, issues, documents, a calendar, habits, mood check-ins, and dashboards in one offline workspace. Your data stays in a local database on your computer."
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:workspace.sqlite3"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5MUI5M0E3RkNGRDk0NTQKUldSVWxQMzhwNU1iT2NxZEVibndvQWNpZWhXWXdYekgxWkJ2czBvMVNnbDY1WjFlVkZyQVEvWnEK",
      "endpoints": [
        "https://github.com/arlecchinoOPSource/Unhollowed-2/releases/download/updater-beta/latest.json"
      ]
    }
  }
}
